# Copy to .env.local (gitignored). Same names on Vercel → Project Settings → Environment Variables.
# Do not commit real keys.

# Optional app chrome (also used in src/app/layout.tsx)
# NEXT_PUBLIC_APP_TITLE — any string; shown in <title>
# NEXT_PUBLIC_SITE_URL — canonical URL, no trailing slash (Open Graph / metadataBase)
NEXT_PUBLIC_APP_TITLE=AI-Powered Weather & Farming Advisory Dashboard
NEXT_PUBLIC_SITE_URL=https://weather-farming.vercel.app

# OpenWeather — https://openweathermap.org/api → API keys (server-only, never NEXT_PUBLIC_)
OPENWEATHER_API_KEY=your_openweather_api_key

# AI (server-only). Fallback: Gemini → Groq → OpenRouter → Hugging Face. Skip a provider by leaving its key empty.
# Gemini — https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key
# Groq — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# Hugging Face (optional last rung) — https://huggingface.co/settings/tokens  (or HF_TOKEN)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Unsplash — https://unsplash.com/oauth/applications → Access Key (backgrounds + gallery)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Optional Agro (reserved) — https://agromonitoring.com/api
AGRO_API_KEY=your_agro_api_key
# Optional ElevenLabs TTS — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Sentry (optional). Empty DSN disables the SDK. Browser events POST same-origin /api/monitoring.
# DSN — https://sentry.io → Project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Optional server alias (falls back to NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=
# Org / project / token — Settings → General (org), Project Settings (project), Settings → Auth Tokens
# Token scopes: project:releases, org:read. Used only for CI source-map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
